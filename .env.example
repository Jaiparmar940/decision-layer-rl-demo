# Copy to .env (gitignored) and fill in.
# Used only by `npm run eval:llm` (Node). The Vite web app does not read this file.

# Default provider (OpenRouter)
OPENROUTER_API_KEY=

# Direct OpenAI: npm run eval:llm -- --provider openai --model gpt-5.6-sol ...
OPENAI_API_KEY=

# Direct Gemini: npm run eval:llm -- --provider google --model gemini-3.5-flash ...
GOOGLE_API_KEY=
